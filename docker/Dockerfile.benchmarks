FROM mcr.microsoft.com/dotnet/sdk:10.0
WORKDIR /workspace
COPY Directory.Build.props global.json ./
COPY src/Nezzen.Core/Nezzen.Core.csproj src/Nezzen.Core/
COPY src/Nezzen.Application/Nezzen.Application.csproj src/Nezzen.Application/
COPY src/Nezzen.Infrastructure/Nezzen.Infrastructure.csproj src/Nezzen.Infrastructure/
COPY tools/Nezzen.Scanner.Benchmarks/Nezzen.Scanner.Benchmarks.csproj tools/Nezzen.Scanner.Benchmarks/
RUN dotnet restore tools/Nezzen.Scanner.Benchmarks
COPY src/Nezzen.Core/ src/Nezzen.Core/
COPY src/Nezzen.Application/ src/Nezzen.Application/
COPY src/Nezzen.Infrastructure/ src/Nezzen.Infrastructure/
COPY tools/Nezzen.Scanner.Benchmarks/ tools/Nezzen.Scanner.Benchmarks/
RUN dotnet publish tools/Nezzen.Scanner.Benchmarks -c Release --no-restore -o /benchmark
ENTRYPOINT ["dotnet", "/benchmark/Nezzen.Scanner.Benchmarks.dll"]
